
#include <stdio.h>

int main() {
    FILE *file;
    char name[100];
    char course[100];
    int age;
    int numStudents;

    // Open file in write mode
    file = fopen("student_records.txt", "w");

    if (file == NULL) {
        printf("Error opening file!\n");
        return 1;
    }

    printf("Writing Student Database:\n");
    printf("How many students do you want to record? ");
    scanf("%d", &numStudents);

    // Input and save student records
    for (int i = 1; i <= numStudents; i++) {
        printf("\nStudent %d\n", i);

        printf("Enter Name: ");
        scanf(" %99[^\n]", name);

        printf("Enter Age: ");
        scanf("%d", &age);

        printf("Enter Course: ");
        scanf(" %99[^\n]", course);

        fprintf(file, "Student %d\n", i);
        fprintf(file, "Name: %s\n", name);
        fprintf(file, "Age: %d\n", age);
        fprintf(file, "Course: %s\n", course);
        fprintf(file, "--------------------\n");
    }

    fclose(file);

    printf("\nStudent database successfully saved to file.\n");

    // Open file in read mode
    file = fopen("student_records.txt", "r");

    if (file == NULL) {
        printf("Error reading file!\n");
        return 1;
    }

    printf("\nReading Student Database:\n\n");

    // Read and display file line by line
    char line[200];

    while (fgets(line, sizeof(line), file) != NULL) {
        printf("%s", line);
    }

    fclose(file);

    return 0;
}
